{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "suffertracker-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "st",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "polyfills": [
              "zone.js"
            ],
            "assets": [],
            "styles": [
              "src/styles.css"
            ],
            "allowedCommonJsDependencies": [
              "tesseract.js",
              "@mozilla/readability"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": []
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "suffertracker-web:build:production"
            },
            "development": {
              "buildTarget": "suffertracker-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}